# 天衍云平台 API 配置
# 复制此文件为 .env 并填写真实值
# 警告：请勿将真实凭证提交到版本控制系统！
#
# 本文件是项目唯一的环境变量模板（Issue #206）。
# config/.env.example 已废弃，请使用根目录的 .env.example。
# 环境变量名与 src/config/settings.py 的 _FIELD_MAP 保持一致。

# ──────────────────────────────────────────────────────────────
# 环境选择（可选）
# ──────────────────────────────────────────────────────────────
# 应用环境标识，用于自动选择 config/config.{env}.yaml
# 可选值：dev / prod / staging；未设置时使用 config/config.yaml
APP_ENV=

# ──────────────────────────────────────────────────────────────
# 天衍云 API 凭证（真实模式必需，Mock 模式可留空）
# ──────────────────────────────────────────────────────────────
# API 主密钥：从天衍云个人中心获取，真实模式必需
# 别名：TIANYAN_API_TOKEN（与 TIANYAN_API_KEY 等效，二选一即可）
TIANYAN_API_KEY=your_api_key_here
# API 密钥别名（与 TIANYAN_API_KEY 等效，设置其一即可）
TIANYAN_API_TOKEN=your_api_token_here
# API Secret（可选，仅当平台要求双因子认证时填写）
TIANYAN_API_SECRET=your_api_secret_here
# 应用 ID（可选，仅当使用应用级鉴权时填写）
TIANYAN_APP_ID=your_app_id_here

# ──────────────────────────────────────────────────────────────
# 量子计算机后端配置
# ──────────────────────────────────────────────────────────────
# 默认量子计算机名称（真实模式使用，可选值见 tianyan_cqlib.REAL_MACHINES）
TIANYAN_MACHINE=tianyan_s
# 量子比特上限（默认 287，对应天衍-287）
# 与 config.yaml 的 quantum.max_qubits 对应
QUANTUM_MAX_QUBITS=287
# 量子电路测量次数（默认 1024）
# 与 config.yaml 的 quantum.shots 对应
QUANTUM_SHOTS=1024

# ──────────────────────────────────────────────────────────────
# Mock 模式配置（开发阶段推荐使用）
# ──────────────────────────────────────────────────────────────
# Mock 模式开关（true: 使用 Mock API，无需真实平台，可离线开发）
TIANYAN_MOCK_MODE=true
# Mock 模式模拟延迟（秒）
# 默认 90.0 来自天衍真机实测均值（s=124s, sw=48s, tn=89s，见 config.yaml mock_machine_delays）
# 与 config.yaml 的 mock_delay 保持一致，避免仿真结果因配置源不同而不可复现
# 开发调试可临时设为 1.0 加速迭代，但性能/统计实验必须使用 90.0 以贴近真机行为
TIANYAN_MOCK_DELAY=90.0
# Mock 模式模拟失败率（0-1），用于测试异常处理
TIANYAN_MOCK_FAILURE_RATE=0.0

# ──────────────────────────────────────────────────────────────
# API 请求超时、重试与限流（可选，未设置时使用默认值）
# ──────────────────────────────────────────────────────────────
# 单次 API 请求超时时间（秒），默认 30.0
TIANYAN_API_TIMEOUT=30.0
# API 请求失败最大重试次数，默认 3
TIANYAN_API_MAX_RETRIES=3
# 重试间隔（秒），默认 1.0
TIANYAN_API_RETRY_DELAY=1.0
# API 请求速率限制（请求/秒），0 表示不限制
TIANYAN_API_RATE_LIMIT=0

# ──────────────────────────────────────────────────────────────
# 调度器配置
# ──────────────────────────────────────────────────────────────
# 调度算法（PPO / DQN），默认 PPO
# 与 config.yaml 的 scheduler.algorithm 对应
SCHEDULER_ALGORITHM=PPO
# 调度器单 episode 最大步数，默认 1000
# 与 config.yaml 的 system.max_steps 对应
SCHEDULER_MAX_STEPS=1000

# ──────────────────────────────────────────────────────────────
# 量子退火配置（可选）
# ──────────────────────────────────────────────────────────────
# 退火模块开关（true: 启用退火优化，false: 纯 RL 训练）
# 与 config.yaml 的 annealing.enabled 对应
ANNEALING_ENABLED=true
# 退火模拟模式（true: 使用经典模拟退火，false: 尝试连接真实量子退火机）
ANNEALING_SIMULATION=true
# 量子加速开关（true: 启用量子加速通道，false: 纯经典退火）
# 由 src/quantum/annealing.py 读取
QUANTUM_ACCELERATION_ENABLED=

# ──────────────────────────────────────────────────────────────
# 日志配置
# ──────────────────────────────────────────────────────────────
# 日志级别（DEBUG / INFO / WARNING / ERROR），默认 INFO
# 与 config.yaml 的 system.log_level 对应
LOG_LEVEL=INFO
# 日志格式（text / json），默认 text
# 由 src/utils/helpers.py 读取
LOG_FORMAT=text
# 日志输出目录，默认 logs
LOG_DIR=logs

# ──────────────────────────────────────────────────────────────
# 数据库与缓存（可选）
# ──────────────────────────────────────────────────────────────
# 数据库路径（SQLite）
DATABASE_PATH=data/scheduler.db
# Redis 配置（如果使用 Redis 缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ──────────────────────────────────────────────────────────────
# Web 可视化面板配置
# ──────────────────────────────────────────────────────────────
# 可视化 API 认证密钥（routes.py 中用于保护 API 端点，留空则禁用认证）
# 与 settings.py _FIELD_MAP 中的 VIZ_API_KEY 一致
VIZ_API_KEY=
# Web 服务监听地址
WEB_HOST=0.0.0.0
# Web 服务端口，默认 8000
# 与 config.yaml 的 web.port 对应
WEB_PORT=8000
# Web 调试模式（true / false）
WEB_DEBUG=true

# ──────────────────────────────────────────────────────────────
# 告警与可观测性（可选）
# ──────────────────────────────────────────────────────────────
# 告警 Webhook URL（如 Slack / 飞书 / 企业微信）
# 由 src/utils/alerts.py 读取；留空则禁用告警推送
ALERT_WEBHOOK_URL=

# ──────────────────────────────────────────────────────────────
# 实验可复现性（可选）
# ──────────────────────────────────────────────────────────────
# 全局随机种子（整数），用于实验复现
# 由 src/utils/seeds.py 读取；未设置时使用系统熵
QUANTUM_RL_SEED=
